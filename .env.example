# MoodMate Environment Configuration Example
# Copy this file to .env or run `python generate_keys.py` to auto-generate.

# Cryptographic Keys (Required)
FERNET_KEY=your-32-byte-base64-fernet-key-here
EMAIL_PEPPER=your-random-hmac-pepper-here
JWT_SECRET=your-random-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# LLM Providers (Free Tiers)
OLLAMA_BASE_URL=http://localhost:11434/v1
DEFAULT_MODEL=ollama/llama3.2
ALLOW_USER_KEYS=true

# Optional Free API Keys (Leave empty to use local Ollama)
# Free key from https://aistudio.google.com/
GEMINI_API_KEY=
# Free key from https://console.groq.com/
GROQ_API_KEY=
# Free key from https://openrouter.ai/
OPENROUTER_API_KEY=
# Optional free key from Google Cloud Console (YouTube Data API v3)
YOUTUBE_API_KEY=

# Storage
EXCEL_DB_PATH=moodmate_data.xlsx

# Security & Limits
RATE_LIMIT=60/minute

